# Build with the repository root as context. Export /native using BuildKit:
# docker build --platform linux/amd64 -f packages/db/Dockerfile.native --output type=local,dest=/tmp/hulladb-native .
FROM rust:1.98.1-bookworm AS build
WORKDIR /build
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
RUN cargo build --release --locked -p hulladb_server --features typescript --bin hulladb-bridge --bin hulladb-service -p hulladb_js --bin hulladb-js
RUN mkdir /native && cp target/release/hulladb-bridge target/release/hulladb-service target/release/hulladb-js /native/

# Maintainer artifact builder; application development does not require Docker.
FROM oven/bun:1.4.4-debian AS bun
FROM debian:bookworm-slim AS development
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
USER root
RUN apt-get update && apt-get install -y --no-install-recommends build-essential bison flex ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY package.json bun.lock ./
COPY packages ./packages
RUN bun install --frozen-lockfile --ignore-scripts
RUN bun run --cwd packages/db build:postgres && bun run --cwd packages/db build:development

FROM scratch AS artifacts
COPY --from=build /native /native
COPY --from=development /build/packages/db/native/linux-x64/hulladb-dev /native/hulladb-dev
COPY --from=development /build/packages/db/native/linux-x64/compiler /native/compiler
COPY --from=development /build/packages/db/native/linux-x64/postgres /native/postgres
COPY --from=development /build/packages/db/native/linux-x64/BUN-LICENSE.md /native/BUN-LICENSE.md
COPY --from=development /build/packages/db/native/linux-x64/development.json /native/development.json
COPY --from=development /build/packages/db/development /development
