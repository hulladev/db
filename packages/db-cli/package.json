{
  "name": "@hulla/db-cli",
  "version": "0.4.0",
  "type": "module",
  "description": "Build, generate and run local development for @hulla/db",
  "exports": {
    "./build": {
      "hulladb-source": "./src/build.ts",
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./codegen": {
      "hulladb-source": "./src/codegen.ts",
      "types": "./dist/codegen.d.ts",
      "default": "./dist/codegen.js"
    }
  },
  "scripts": {
    "build": "bun ../db/scripts/build-binding.ts cli.js",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@hulla/db": "^0.4.0",
    "@hulla/db-postgres": "^0.4.0",
    "@hulla/db-studio": "^0.4.0"
  },
  "devDependencies": {
    "@hulla/db": "workspace:*",
    "@types/bun": "1.4.2",
    "@types/node": "26.2.0",
    "@hulla/db-postgres": "workspace:*",
    "@hulla/db-studio": "workspace:*"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "license": "MIT",
  "author": {
    "name": "Samuel Hulla",
    "url": "https://hulla.dev"
  },
  "homepage": "https://github.com/hulladev/db#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hulladev/db.git",
    "directory": "packages/db-cli"
  },
  "bugs": {
    "url": "https://github.com/hulladev/db/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "hulla-db": "./dist/cli.js"
  },
  "peerDependenciesMeta": {
    "@hulla/db-postgres": {
      "optional": true
    },
    "@hulla/db-studio": {
      "optional": true
    }
  },
  "dependencies": {
    "typescript": "7.0.2"
  }
}
